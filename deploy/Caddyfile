experts.56north.io {
	encode zstd gzip
	reverse_proxy web:3000
}

# --- 56north.io (main site) ---------------------------------------------------
# The previous site stays on its original host (146.59.209.152) as a fallback:
# pointing the DNS A records of 56north.io and www back to it restores it.
56north.io {
	encode zstd gzip
	reverse_proxy main:3000
}

www.56north.io, new.56north.io {
	redir https://56north.io{uri} permanent
}
